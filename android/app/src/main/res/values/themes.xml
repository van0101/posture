<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Posture" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/carbon</item>
        <item name="android:statusBarColor">@color/carbon</item>
        <item name="android:navigationBarColor">@color/carbon</item>
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:colorControlActivated">@color/amber</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorHint">@color/mute</item>
    </style>

    <style name="Label">
        <item name="android:textColor">@color/mute</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Heading">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Custom">
        <item name="android:background">@drawable/edit_bg</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">3</item>
        <item name="android:hint">min</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>
